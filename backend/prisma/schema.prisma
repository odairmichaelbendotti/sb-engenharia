generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN // Estado maior
  MASTER // Comandantes da OM
  COORDENACAO // vê e edita Engenharia + Administrativo
  ENGENHARIA // vê e edita só Engenharia (Obra, Medição)
  ADMINISTRATIVO // vê e edita só Administrativo (Company, Empenho, Invoice)
  USER // vê os dois domínios, edita nenhum
  EMPRESA // login da empresa contratada — só vê Mapa de Obras, filtrado pelo próprio company_id
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  apelido   String   @unique
  cnpj      String   @unique
  cep       String
  city      String
  state     String
  address   String
  phone     String
  email     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  users         User[]
  obras         Obra[]
  contratos     Contrato[]
  empenhos      Empenho[]
  ordensServico OrdemServico[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  approved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])
}

model Company {
  id                String   @id @default(uuid())
  name              String
  cnpj              String   @unique
  cep               String
  city              String
  state             String
  address           String
  phone             String
  email             String
  hasActiveContract Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  invoices  Invoice[]
  contratos Contrato[]
  users     User[]
}

enum ObraStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PARALISADA
  CANCELADA
}

enum ObraTipo {
  CONSTRUCAO
  REFORMA
  AMPLIACAO
  PAVIMENTACAO
  SANEAMENTO
  MANUTENCAO_PREDIAL
  OUTRO
}

model Obra {
  id                     String     @id @default(uuid())
  nome                   String
  identificacaoPatrimonial String   @default("E-00")
  tipo                   ObraTipo
  status              ObraStatus @default(EM_ANDAMENTO)
  descricao           String
  latitude            Float?
  longitude           Float?
  valorExecutado      Int        @default(0)
  dataInicio          DateTime
  dataPrevisaoTermino DateTime
  dataConclusao       DateTime?
  responsavelTecnico  String
  anotacoes           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  ordemServico_id String       @unique
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id])

  invoices Invoice[]
}

enum EmpenhoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

enum EmpenhoCategory {
  MANUTENCAO_PREDIAL
  ALIMENTACAO
  HOSPITALAR
  COMBUSTIVEL
  TECNOLOGIA
  LIMPEZA_CONSERVACAO
  SEGURANCA_VIGILANCIA
  OUTROS
}

enum ContratoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

model Contrato {
  id             String         @id @default(uuid())
  identificador  String
  descricaoCurta String
  valor          Int
  dataInicio     DateTime
  dataFim        DateTime
  status         ContratoStatus @default(ATIVO)
  cor            String         @default("#4478b6")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  empenhos Empenho[]

  @@unique([identificador, tenant_id])
}

model Empenho {
  id          String        @id @default(uuid())
  numero      String        @unique
  description String
  category    EmpenhoCategory
  startAt     DateTime
  endAt       DateTime
  value       Int
  totalPaid   Int           @default(0)
  status      EmpenhoStatus @default(ATIVO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  contrato_id String
  contrato    Contrato  @relation(fields: [contrato_id], references: [id])
  invoices      Invoice[]
  ordensServico OrdemServico[]
}

enum OrdemServicoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

model OrdemServico {
  id        String             @id @default(uuid())
  numero    String
  valor     Int
  status    OrdemServicoStatus @default(ATIVO)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  empenho_id String
  empenho    Empenho @relation(fields: [empenho_id], references: [id])

  obra Obra?

  @@unique([numero, tenant_id])
}

enum InvoiceStatus {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

model Invoice {
  id          String        @id @default(uuid())
  numero      String
  description String
  vencimento  DateTime
  value       Int
  status      InvoiceStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  empenho_id String
  empenho    Empenho @relation(fields: [empenho_id], references: [id], onDelete: Cascade)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  obra_id String?
  obra    Obra?   @relation(fields: [obra_id], references: [id])

  @@map("nota_fiscal")
}
