generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN // Estado maior
  MASTER // Comandantes da OM
  COORDENACAO // vê e edita Engenharia + Administrativo
  ENGENHARIA // vê e edita só Engenharia (Obra, Medição)
  ADMINISTRATIVO // vê e edita só Administrativo (Company, Empenho, Invoice)
  USER // vê os dois domínios, edita nenhum
  EMPRESA // login da empresa contratada — só vê Mapa de Obras, filtrado pelo próprio company_id
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  apelido   String   @unique
  cnpj      String   @unique
  cep       String
  city      String
  state     String
  address   String
  phone     String
  email     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  users         User[]
  obras         Obra[]
  contratos     Contrato[]
  empenhos      Empenho[]
  ordensServico OrdemServico[]
  companies     TenantCompany[]
  notificacoes  Notificacao[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  approved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  notificacoesLidas NotificacaoLeitura[]
}

model Company {
  id                String   @id @default(uuid())
  name              String
  cnpj              String   @unique
  cep               String
  city              String
  state             String
  address           String
  phone             String
  email             String
  hasActiveContract Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  invoices  Invoice[]
  contratos Contrato[]
  users     User[]
  tenants   TenantCompany[]
  notificacoes Notificacao[]
}

// Empresa cadastrada para uma organização. Company é global (CNPJ único) porque a
// mesma empresa pode atender várias bases; cada base só enxerga as empresas vinculadas a ela.
model TenantCompany {
  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([tenant_id, company_id])
}

enum ObraStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PARALISADA
  CANCELADA
}

enum ObraTipo {
  CONSTRUCAO
  REFORMA
  AMPLIACAO
  PAVIMENTACAO
  SANEAMENTO
  MANUTENCAO_PREDIAL
  OUTRO
}

model Obra {
  id                     String     @id @default(uuid())
  nome                   String
  identificacaoPatrimonial String   @default("E-00")
  tipo                   ObraTipo
  status              ObraStatus @default(EM_ANDAMENTO)
  descricao           String
  latitude            Float?
  longitude           Float?
  valorExecutado      Int        @default(0)
  // Cronograma fica nas OS da obra; a obra guarda só a data em que foi concluída
  dataConclusao       DateTime?
  responsavelTecnico  String
  anotacoes           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now())

  // Dados da edificação que saem na Ordem de Serviço; nulos nas obras anteriores a eles
  idPatrimonialCompleto String? // ex.: SC.027-67272-E-050
  apelido               String? // ex.: SCOAM-FL
  areaConstruida        Float? // m²
  estadoConservacao     String?

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // Uma obra pode ter várias OS (ex.: serviço que faltou vira uma nova OS)
  ordensServico OrdemServico[]

  invoices Invoice[]
}

enum EmpenhoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

enum EmpenhoCategory {
  MANUTENCAO_PREDIAL
  ALIMENTACAO
  HOSPITALAR
  COMBUSTIVEL
  TECNOLOGIA
  LIMPEZA_CONSERVACAO
  SEGURANCA_VIGILANCIA
  OUTROS
}

enum ContratoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

model Contrato {
  id             String         @id @default(uuid())
  identificador  String
  descricaoCurta String
  valor          Int
  dataInicio     DateTime
  dataFim        DateTime
  status         ContratoStatus @default(ATIVO)
  cor            String         @default("#4f759c")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())

  // Dados que saem na Ordem de Serviço. Obrigatórios no cadastro; os contratos que já
  // existiam ficam com o placeholder até alguém preencher
  ePag             String @default("A PREENCHER")
  etp              String @default("A PREENCHER")
  termoReferencia  String @default("A PREENCHER")
  dataBaseSinapi   String @default("A PREENCHER")
  endereco         String @default("A PREENCHER")
  // BDI em porcentagem (ex.: 21.19)
  bdi              Float  @default(21.19)

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  empenhos Empenho[]
  lotes    Lote[]
  fiscais  FiscalContrato[]

  @@unique([identificador, tenant_id])
}

// Lote da licitação (opcional por contrato): guarda o desconto que a empresa ofertou nele
model Lote {
  id       String @id @default(uuid())
  numero   Int
  nome     String
  // Desconto em porcentagem (ex.: 24.8)
  desconto Float

  contrato_id String
  contrato    Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)

  ordensServico OrdemServico[]

  @@unique([contrato_id, numero])
}

enum FiscalContratoTipo {
  TECNICO
  ADMINISTRATIVO
}

// Fiscais do contrato; cada OS escolhe entre eles o técnico e o administrativo
model FiscalContrato {
  id      String             @id @default(uuid())
  tipo    FiscalContratoTipo
  // Posto/graduação e nome, como sai no documento (ex.: "1º SGT FLORIANO")
  nome    String
  ramal   String
  email   String

  contrato_id String
  contrato    Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)

  ordensServicoTecnico        OrdemServico[] @relation("FiscalTecnicoOS")
  ordensServicoAdministrativo OrdemServico[] @relation("FiscalAdministrativoOS")

  @@index([contrato_id])
}

model Empenho {
  id          String        @id @default(uuid())
  numero      String        @unique
  description String
  category    EmpenhoCategory
  startAt     DateTime
  endAt       DateTime
  value       Int
  totalPaid   Int           @default(0)
  status      EmpenhoStatus @default(ATIVO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  contrato_id String
  contrato    Contrato  @relation(fields: [contrato_id], references: [id])
  invoices      Invoice[]
  // OS que têm este como empenho principal (define o contrato da OS)
  ordensServico OrdemServico[]
  // Quanto deste empenho foi destinado a cada OS
  vinculosOrdemServico OrdemServicoEmpenho[]
}

enum OrdemServicoStatus {
  ATIVO
  FINALIZADO
  CANCELADO
}

model OrdemServico {
  id        String             @id @default(uuid())
  numero    String
  valor     Int
  status    OrdemServicoStatus @default(ATIVO)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // Empenho principal: o primeiro vinculado. Todos os empenhos da OS são do mesmo
  // contrato, então é por ele que se chega ao contrato, à empresa e à cor no mapa
  empenho_id String
  empenho    Empenho @relation(fields: [empenho_id], references: [id])

  // Empenhos que financiam a OS; "valor" da OS é a soma deles
  empenhos OrdemServicoEmpenho[]

  // Cronograma de execução da OS
  dataInicio          DateTime?
  dataPrevisaoTermino DateTime?

  // Obra em que a OS é executada; ao excluir a obra a OS volta a ficar sem obra
  obra_id String?
  obra    Obra?   @relation(fields: [obra_id], references: [id], onDelete: SetNull)

  invoices Invoice[]

  // Dados do documento da OS; nulos nas OS anteriores a eles
  // Numeração: sequência por lote e ano (começa em 10); nula nas OS com número antigo
  sequencia           Int?
  anoNumeracao        Int?
  lote_id             String?
  lote                Lote?                @relation(fields: [lote_id], references: [id], onDelete: Restrict)
  setorRequisitante   String?
  urgencia            OrdemServicoUrgencia?
  dataVistoria        DateTime?
  descricaoProblema   String?
  dataEmissao         DateTime?
  // Dias de mobilização, já incluídos no prazo total
  prazoMobilizacaoDias Int                  @default(7)
  prazoDias           Int?
  // Total com BDI em centavos: informado nas OS antigas; nas com orçamento sai da soma dos itens
  totalComBdi         Int?
  // Como os preços do orçamento foram informados (o sistema aplica o desconto em COM_BDI)
  precoBase           OrcamentoPrecoBase   @default(COM_BDI)
  // Como o desconto é aplicado em cada preço no modo COM_BDI
  regraDesconto       RegraDesconto        @default(SIMPLES)
  // Desconto do lote copiado na criação, em porcentagem: editar o lote depois não muda a OS
  desconto            Float                @default(0)
  // Criada e ainda não emitida (sem orçamento): a empresa não vê
  aguardandoEmissao   Boolean              @default(false)
  fiscalSetorial      String?
  fiscalTecnico_id    String?
  fiscalTecnico       FiscalContrato?      @relation("FiscalTecnicoOS", fields: [fiscalTecnico_id], references: [id], onDelete: SetNull)
  fiscalAdministrativo_id String?
  fiscalAdministrativo    FiscalContrato?  @relation("FiscalAdministrativoOS", fields: [fiscalAdministrativo_id], references: [id], onDelete: SetNull)
  condicoesEspeciais  String[]             @default([])

  // Ciência da empresa (horário do servidor). As OS anteriores a esta regra ficam
  // com a ciência dispensada e nunca travam a empresa
  emitidaEm          DateTime?
  cienciaPrazoAte    DateTime?
  cienciaDispensada  Boolean   @default(false)
  // Primeira vez que a empresa abriu a OS (a mais recente emissão)
  visualizadaEm      DateTime?
  cienteEm           DateTime?
  cienteUser_id      String?
  cienteNome         String?
  // Marca que o vencimento do prazo já virou evento no histórico (uma vez por emissão)
  prazoVencidoEm     DateTime?

  eventos       OrdemServicoEvento[]
  contestacoes  OrdemServicoContestacao[]
  notificacoes  Notificacao[]

  // Planilha orçamentária (opcional) e as medições feitas sobre ela
  itens    OrdemServicoItem[]
  medicoes Medicao[]

  @@unique([numero, tenant_id])
  @@index([obra_id])
  @@index([lote_id])
}

enum OrdemServicoUrgencia {
  EMERGENCIA
  URGENCIA
  PROGRAMADA
  PREVENTIVA
}

enum OrdemServicoEventoTipo {
  EMITIDA
  REEMITIDA
  VISUALIZADA
  CIENTE
  PRAZO_VENCIDO
  CONTESTACAO
  CONTESTACAO_ACATADA
  CONTESTACAO_RECUSADA
  COMENTARIO
  STATUS_ALTERADO
}

// Histórico da tramitação da OS: só recebe inserções (um gatilho no banco barra UPDATE).
// O autor é copiado (nome, perfil, empresa) para o registro não mudar se o usuário mudar
model OrdemServicoEvento {
  id        String                 @id @default(uuid())
  tipo      OrdemServicoEventoTipo
  texto     String?
  createdAt DateTime               @default(now())

  ordemServico_id String
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  // Nulo nos eventos automáticos (vencimento do prazo)
  autor_id      String?
  autorNome     String
  autorPerfil   String
  autorEmpresa  String?

  contestacao_id String?
  contestacao    OrdemServicoContestacao? @relation(fields: [contestacao_id], references: [id], onDelete: Cascade)

  @@index([ordemServico_id, createdAt])
}

enum OrdemServicoContestacaoStatus {
  ABERTA
  ACATADA
  RECUSADA
}

// Apontamento da empresa sobre a OS; a fiscalização decide uma vez (acatar ou recusar)
model OrdemServicoContestacao {
  id        String                        @id @default(uuid())
  texto     String
  status    OrdemServicoContestacaoStatus @default(ABERTA)
  createdAt DateTime                      @default(now())

  ordemServico_id String
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  autor_id   String
  autorNome  String

  resposta          String?
  respondidoPor_id  String?
  respondidoPorNome String?
  respondidoEm      DateTime?

  eventos OrdemServicoEvento[]

  @@index([ordemServico_id, status])
}

enum NotificacaoDestino {
  // Usuários EMPRESA da empresa indicada
  EMPRESA
  // Perfis internos da organização
  FISCALIZACAO
}

enum NotificacaoTipo {
  OS_EMITIDA
  OS_REEMITIDA
  OS_CIENTE
  OS_PRAZO_VENCIDO
  OS_CONTESTACAO
  OS_CONTESTACAO_RESPONDIDA
  OS_COMENTARIO
}

// Aviso dentro do sistema; a leitura é registrada por usuário
model Notificacao {
  id        String             @id @default(uuid())
  destino   NotificacaoDestino
  tipo      NotificacaoTipo
  titulo    String
  mensagem  String
  createdAt DateTime           @default(now())

  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)

  ordemServico_id String?
  ordemServico    OrdemServico? @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  leituras NotificacaoLeitura[]

  @@index([tenant_id, destino, createdAt])
  @@index([company_id, createdAt])
}

model NotificacaoLeitura {
  notificacao_id String
  notificacao    Notificacao @relation(fields: [notificacao_id], references: [id], onDelete: Cascade)
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lidaEm         DateTime    @default(now())

  @@id([notificacao_id, user_id])
  @@index([user_id])
}

// Vínculo OS × empenho: quanto de cada empenho vai para a OS. Por padrão o empenho
// inteiro; um empenho ainda pode ser dividido entre OS (ex.: manutenções)
model OrdemServicoEmpenho {
  id        String   @id @default(uuid())
  valor     Int
  createdAt DateTime @default(now())

  ordemServico_id String
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  empenho_id String
  empenho    Empenho @relation(fields: [empenho_id], references: [id], onDelete: Restrict)

  @@unique([ordemServico_id, empenho_id])
  @@index([empenho_id])
}

// Como os preços do orçamento da OS foram informados
enum OrcamentoPrecoBase {
  // Só com BDI: o sistema aplica o desconto da OS, truncando o centavo
  COM_BDI
  COM_BDI_E_DESCONTO
}

enum RegraDesconto {
  // Preço com desconto truncado no centavo; total = quantidade × preço
  SIMPLES
  // Planilha SCOAM: trunca o valor do desconto e o total do item
  SCOAM
}

// Item da planilha orçamentária da OS. O preço unitário é o que vale nas medições: com BDI e desconto
model OrdemServicoItem {
  id            String   @id @default(uuid())
  // Posição na planilha (1, 2, 3...)
  ordem         Int
  // Referência da composição (ex.: código SINAPI), opcional
  codigo        String?
  descricao     String
  // Etapa do orçamento (ex.: "Remoção/demolição"): os itens seguidos com a mesma etapa formam um grupo
  etapa         String?
  unidade       String
  // Quantidade orçada em cem-milésimos da unidade (5 casas: 3,5 m² = 350000)
  quantidade    BigInt
  // Supressão: parte da quantidade que saiu do contrato, na mesma escala. O item fica na planilha e
  // vale pela quantidade efetiva (quantidade − suprimida)
  quantidadeSuprimida BigInt @default(0)
  // Centavos
  precoUnitario Int
  // Preço com BDI digitado, em centavos (só no modo COM_BDI; o unitário é ele com o desconto)
  precoReferencia Int?
  // Total em centavos digitado para bater com a planilha de referência (truncamento, preço com
  // mais casas); nulo = quantidade × preço. Nas medições, o item medido por inteiro vale este total
  valorTotal    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  ordemServico_id String
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  // Excluir o item leva junto as linhas de rascunho; item com quantidade em medição fechada é
  // barrado por gatilho no banco (a exclusão da OS ainda apaga tudo em cascata)
  medicoes MedicaoItem[]

  @@index([ordemServico_id, ordem])
}

enum MedicaoStatus {
  RASCUNHO
  FECHADA
}

// Medição da OS: quanto de cada item foi executado no período. O rascunho não conta no
// acumulado; a fechada fica travada (gatilho no banco) e só a última pode ser reaberta
model Medicao {
  id            String        @id @default(uuid())
  // Sequência por OS; também garante um rascunho só por vez (o rascunho leva o próximo número)
  numero        Int
  status        MedicaoStatus @default(RASCUNHO)
  // Datas sem horário (meia-noite UTC)
  periodoInicio DateTime
  periodoFim    DateTime
  observacao    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())

  // Autores copiados, como no histórico da OS
  criadoPor_id    String?
  criadoPorNome   String
  fechadaEm       DateTime?
  fechadaPor_id   String?
  fechadaPorNome  String?
  reabertaEm      DateTime?
  reabertaPorNome String?

  // Planilha congelada no fechamento: a reimpressão sai igual à assinada mesmo que o
  // orçamento mude depois. Nula no rascunho
  planilhaFechamento Json?

  ordemServico_id String
  ordemServico    OrdemServico @relation(fields: [ordemServico_id], references: [id], onDelete: Cascade)

  itens MedicaoItem[]

  // Notas fiscais que pagam esta medição (só uma não cancelada)
  invoices Invoice[]

  @@unique([ordemServico_id, numero])
}

// Quantidade medida de um item; só existem linhas com quantidade maior que zero
model MedicaoItem {
  id         String @id @default(uuid())
  // Cem-milésimos da unidade (5 casas)
  quantidade BigInt

  medicao_id String
  medicao    Medicao @relation(fields: [medicao_id], references: [id], onDelete: Cascade)

  item_id String
  item    OrdemServicoItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([medicao_id, item_id])
  @@index([item_id])
}

enum InvoiceStatus {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

model Invoice {
  id          String        @id @default(uuid())
  numero      String
  description String
  vencimento  DateTime
  value       Int
  status      InvoiceStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  empenho_id String
  empenho    Empenho @relation(fields: [empenho_id], references: [id], onDelete: Cascade)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  obra_id String?
  obra    Obra?   @relation(fields: [obra_id], references: [id])

  // OS da obra a que a nota se refere: é por ela que se mede a execução de cada OS
  ordemServico_id String?
  ordemServico    OrdemServico? @relation(fields: [ordemServico_id], references: [id], onDelete: Restrict)

  // Medição fechada da OS que a nota paga: o valor da nota é o dela. Nula = valor digitado.
  // Uma nota não cancelada por medição; a medição com nota não reabre nem sai
  medicao_id String?
  medicao    Medicao? @relation(fields: [medicao_id], references: [id], onDelete: SetNull)

  @@index([ordemServico_id])
  @@index([medicao_id])
  @@map("nota_fiscal")
}
